# Development defaults to SQLite. For MariaDB, set DB_ENGINE=mysql and configure below.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_ENGINE=mysql
DB_NAME=news_db
DB_USER=news_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
APPROVED_API_SECRET=replace-with-a-long-random-secret
APPROVED_API_URL=http://127.0.0.1:8000/api/approved/
